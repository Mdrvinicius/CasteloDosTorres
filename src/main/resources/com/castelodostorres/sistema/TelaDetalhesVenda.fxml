<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.castelodostorres.sistema.controlador.ControladorDetalhesVenda"
            fitToWidth="true" styleClass="painel-conteudo">

    <VBox spacing="16">
        <padding><Insets top="20" right="20" bottom="20" left="20" /></padding>

        <HBox alignment="CENTER_LEFT">
            <Button text="← Voltar" onAction="#voltar" styleClass="botao-secundario" />
        </HBox>

        <VBox styleClass="card" spacing="16">
            <Label text="Detalhes da Venda" styleClass="subtitulo" />

            <HBox spacing="30">
                <VBox spacing="2">
                    <Label text="Data / Hora" styleClass="form-label" />
                    <Label fx:id="labelData" text="-" styleClass="detalhe-valor" />
                </VBox>
                <VBox spacing="2">
                    <Label text="Valor Total" styleClass="form-label" />
                    <Label fx:id="labelTotal" text="-" styleClass="valor-positivo" />
                </VBox>
                <VBox spacing="2">
                    <Label text="Forma de Pagamento" styleClass="form-label" />
                    <Label fx:id="labelForma" text="-" styleClass="detalhe-valor" />
                </VBox>
                <VBox spacing="2">
                    <Label text="Status" styleClass="form-label" />
                    <Label fx:id="labelStatus" text="-" />
                </VBox>
            </HBox>

            <Label fx:id="labelMotivo" text="" wrapText="true" styleClass="valor-negativo" />

            <Label text="Itens" styleClass="subtitulo" />
            <TableView fx:id="tabelaItens" prefHeight="260">
                <columns>
                    <TableColumn fx:id="colProduto" text="Produto" prefWidth="220" />
                    <TableColumn fx:id="colQtd" text="Qtd" prefWidth="80" />
                    <TableColumn fx:id="colPrecoUnit" text="Preço Unit. (R$)" prefWidth="130" />
                    <TableColumn fx:id="colSubtotal" text="Subtotal (R$)" prefWidth="130" />
                </columns>
            </TableView>
        </VBox>

    </VBox>
</ScrollPane>