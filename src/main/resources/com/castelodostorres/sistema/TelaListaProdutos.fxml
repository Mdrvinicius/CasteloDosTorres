<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.castelodostorres.sistema.controlador.ControladorTelaListaProdutos"
            fitToWidth="true" styleClass="painel-conteudo">

    <VBox spacing="16">
        <padding><Insets top="20" right="20" bottom="20" left="20" /></padding>

        <HBox alignment="CENTER_LEFT" spacing="12">
            <Button text="← Voltar" onAction="#voltar" styleClass="botao-secundario" />
            <VBox spacing="2">
                <Label text="Produtos" styleClass="titulo-tela" />
                <Label text="Gerencie os produtos cadastrados. Dê duplo-clique para editar." styleClass="texto-suave" />
            </VBox>
        </HBox>

        <VBox styleClass="card" spacing="10">
            <TableView fx:id="tabelaProdutos" prefHeight="440">
                <columns>
                    <TableColumn fx:id="colunaNome" text="Nome" prefWidth="220" />
                    <TableColumn fx:id="colunaCategoria" text="Categoria" prefWidth="150" />
                    <TableColumn fx:id="colunaCusto" text="Custo (R$)" prefWidth="110" />
                    <TableColumn fx:id="colunaVenda" text="Venda (R$)" prefWidth="110" />
                    <TableColumn fx:id="colunaEstoque" text="Estoque" prefWidth="100" />
                </columns>
            </TableView>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label fx:id="labelTotal" text="Total de produtos: 0" styleClass="texto-suave" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="Novo Produto" onAction="#novoProduto" />
                <Button fx:id="botaoExcluir" text="Excluir Selecionado" onAction="#excluir" styleClass="botao-perigo" />
            </HBox>
        </VBox>

    </VBox>
</ScrollPane>